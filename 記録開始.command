#!/bin/bash
cd "$(dirname "$0")"
clear
echo "==============================================="
echo "  つくばVPN 接続テストの記録を開始します"
echo "==============================================="
echo
./record.sh start
echo
echo "-----------------------------------------------"
echo "このあとの手順:"
echo "  1. Claude / Cowork を終了してよいです（記録は続きます）"
echo "  2. つくばVPN.app で「VPN につなぐ」を押す"
echo "  3. つながったら 30秒ほど待って、ブラウザなどで通信を試す"
echo "  4. 「VPN を切る」を押す"
echo "  5. 記録停止.command をダブルクリック"
echo "-----------------------------------------------"
echo
echo "このウィンドウは閉じて構いません。"
